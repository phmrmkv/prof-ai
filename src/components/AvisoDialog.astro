---
interface Props {
  id: string;
  titulo: string;
  texto: string;
}
const { id, titulo, texto } = Astro.props;
---

<dialog id={id} class="aviso" aria-labelledby={`${id}-titulo`} aria-describedby={`${id}-texto`}>
  <div class="aviso-corpo">
    <button type="button" class="aviso-fechar" data-fechar aria-label="Fechar">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18M6 6l12 12"></path></svg>
    </button>
    <h2 id={`${id}-titulo`}>{titulo}</h2>
    <p id={`${id}-texto`}>{texto}</p>
    <div class="aviso-acoes">
      <button type="button" class="botao botao-neutro" data-fechar>Entendi</button>
    </div>
  </div>
</dialog>
