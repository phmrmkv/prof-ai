---
import Base from '@/layouts/Base.astro';
import Cabecalho from '@/components/Cabecalho.astro';
import Rodape from '@/components/Rodape.astro';
---

<Base title="Página não encontrada | Prof.ai" description="Esta página não existe no Prof.ai." noindex>
  <Cabecalho slot="topo" raiz="/" />
  <section class="pagina-erro">
    <div class="contorno">
      <h1>Esta página não existe.</h1>
      <p>O endereço pode ter mudado ou ter sido digitado errado. A página inicial mostra tudo o que há por enquanto.</p>
      <a href="/" class="botao botao-primario">Voltar ao início</a>
    </div>
  </section>
  <Rodape slot="rodape" />
</Base>
